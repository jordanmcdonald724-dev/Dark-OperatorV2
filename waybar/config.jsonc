{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": ["custom/launcher","custom/stn1","custom/stn2","custom/stn3","custom/stn4","custom/stn5","hyprland/window"],
  "modules-center": [],
  "modules-right": ["tray","network","pulseaudio","battery","clock","custom/power"],

  "custom/launcher": {
    "format": " SYS ",
    "tooltip": "Applications",
    "on-click": "~/.config/dark-operator-v2/scripts/launcher.sh"
  },

  "custom/stn1": {"exec":"~/.config/dark-operator-v2/scripts/station-status.sh 1","return-type":"json","interval":1,"on-click":"hyprctl dispatch workspace 1"},
  "custom/stn2": {"exec":"~/.config/dark-operator-v2/scripts/station-status.sh 2","return-type":"json","interval":1,"on-click":"hyprctl dispatch workspace 2"},
  "custom/stn3": {"exec":"~/.config/dark-operator-v2/scripts/station-status.sh 3","return-type":"json","interval":1,"on-click":"hyprctl dispatch workspace 3"},
  "custom/stn4": {"exec":"~/.config/dark-operator-v2/scripts/station-status.sh 4","return-type":"json","interval":1,"on-click":"hyprctl dispatch workspace 4"},
  "custom/stn5": {"exec":"~/.config/dark-operator-v2/scripts/station-status.sh 5","return-type":"json","interval":1,"on-click":"hyprctl dispatch workspace 5"},

  "hyprland/window": {"format":"{title}","max-length":46,"separate-outputs":true,"rewrite":{"":"READY"}},
  "tray": {"icon-size":17,"spacing":7},

  "network": {
    "format-wifi":"NET {signalStrength}%",
    "format-ethernet":"NET WIRED",
    "format-disconnected":"NET OFF",
    "tooltip-format-wifi":"{essid}\\n{ipaddr}",
    "on-click":"nm-connection-editor"
  },

  "pulseaudio": {"format":"VOL {volume}%","format-muted":"VOL MUTED","scroll-step":5,"on-click":"pavucontrol"},

  "battery": {
    "states":{"warning":30,"critical":15},
    "format":"BAT {capacity}%",
    "format-charging":"BAT {capacity}% +",
    "format-plugged":"BAT AC"
  },

  "clock": {
    "format":"{:%H:%M}",
    "format-alt":"{:%a %d %b  %H:%M}",
    "tooltip-format":"<tt><small>{calendar}</small></tt>",
    "calendar":{"mode":"month","weeks-pos":"right","on-scroll":1}
  },

  "custom/power": {
    "format":" PWR ",
    "tooltip":"Lock / logout / reboot / shutdown",
    "on-click":"~/.config/dark-operator-v2/scripts/power.sh"
  }
}
